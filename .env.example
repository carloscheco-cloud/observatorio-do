APP_ENV=development
APP_DEBUG=false
DATABASE_URL=postgresql+psycopg://observatorio:observatorio@localhost:5432/observatorio
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
POSTGRES_DB=observatorio
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=observatorio
# Use 5433 when the host's port 5432 is already occupied.
POSTGRES_HOST_PORT=5432
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_PATH=.data/artifacts
# Production S3-compatible storage:
# S3_ENDPOINT_URL=https://s3.example.invalid
# S3_REGION=us-east-1
# S3_BUCKET=oed-artifacts
# S3_ACCESS_KEY_ID=set-outside-the-repository
# S3_SECRET_ACCESS_KEY=set-outside-the-repository
INGESTION_SCHEDULER_ENABLED=false

